# VideoSubtitleTranslator 环境变量配置
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env

# LLM API 密钥（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# LLM API 地址（可选）
# LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions

# LLM 模型名（可选）
# LLM_MODEL=deepseek-chat

# yt-dlp cookies 文件路径（可选，用于绕过 YouTube 反爬）
# 在 Chrome 安装 "Get cookies.txt LOCALLY" 插件，访问 youtube.com 导出
COOKIES_FILE=/Users/you/Downloads/www.youtube.com_cookies.txt
