<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>zimu</AssemblyName>
        <RootNamespace>VideoSubtitleTranslator</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="pipeline.config.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="pipeline_meme.config.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Config/translator.config.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Config/translator_meme.config.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="PythonScripts/subtitler.py" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="PythonScripts/requirements.txt" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="scripts/init_python_venv.sh" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="scripts/setup_windows.ps1" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="scripts/zm" Link="zm" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="Prompts/**/*.md" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Web/**/*" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="pipeline.web.config.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VideoSubtitleTranslator.Tests" />
    </ItemGroup>

</Project>
